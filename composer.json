{
    "name": "chencongbao/laravel-vben-admin",
    "description": "A Laravel 13 API foundation for Vben Admin applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/sanctum": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Chencongbao\\LaravelVbenAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chencongbao\\LaravelVbenAdmin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chencongbao\\LaravelVbenAdmin\\LaravelVbenAdminServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    }
}
